{
  "rules": {
    ".read": false,
    ".write": false,
    "chatRoom": {
      "users": {
        ".read": "auth != null && root.child('chatRoom/users').child(auth.uid).child('accessUntil').val() > now && root.child('chatRoom/users').child(auth.uid).child('connections').hasChildren() && query.orderByChild === \"accessUntil\" && query.limitToLast != null && query.limitToLast <= 20",
        "$userId": {
          ".read": "auth != null && $userId === auth.uid",
          "connections": {
            "$connectionId": {
              ".write": "auth != null && $userId === auth.uid && (!newData.exists() || (data.exists() && data.child('lastSeen').val() + 90000 > now))",
              ".validate": "newData.hasChildren(['joinedAt','lastSeen','state','isTyping','typingAt']) && newData.child('joinedAt').val() === data.child('joinedAt').val() && newData.child('lastSeen').val() === data.child('lastSeen').val()",
              "joinedAt": {
                ".validate": "newData.isNumber()"
              },
              "lastSeen": {
                ".validate": "newData.isNumber()"
              },
              "state": {
                ".validate": "newData.val() === 'online' || newData.val() === 'away'"
              },
              "isTyping": {
                ".validate": "newData.isBoolean()"
              },
              "typingAt": {
                ".validate": "newData.isNumber() && newData.val() >= now - 60000 && newData.val() <= now + 60000"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        },
        ".indexOn": [
          "accessUntil"
        ]
      },
      "metadata": {
        ".read": "auth != null && root.child('chatRoom/users').child(auth.uid).child('accessUntil').val() > now && root.child('chatRoom/users').child(auth.uid).child('connections').hasChildren()",
        ".write": false
      }
    },
    "chatMessages": {
      ".read": "auth != null && root.child('chatRoom/users').child(auth.uid).child('accessUntil').val() > now && root.child('chatRoom/users').child(auth.uid).child('connections').hasChildren() && query.orderByChild === \"timestamp\" && query.limitToLast != null && query.limitToLast <= 50",
      ".write": false,
      ".indexOn": [
        "timestamp"
      ]
    },
    "chatMessageAcks": {
      ".indexOn": ".value"
    },
    "chatDeletionAcks": {
      ".indexOn": ".value"
    }
  }
}
